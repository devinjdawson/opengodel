/* Docs sidebar — injected on each /docs/commands/<slug>.html page.
   Wraps <article class="doc-wrap"> in a <div class="doc-shell"> grid and
   prepends the same TOC structure used on /docs.html. Source of truth for
   command catalog is /assets/js/commands.js (window.GODEL_COMMANDS).
   Categories mirror docs.html so the two stay in lockstep. */
(function () {
  var CATS = [
    { label: "Company & Security Analysis",
      cmds: ["DES", "FA", "ERN", "EM", "SI", "GR", "ANR", "EVT", "DVD"] },
    { label: "Market Data & Surveillance",
      cmds: ["QM", "FOCUS", "TAS", "HCP", "WEI", "WEIF", "IMAP", "HMAP", "GLCO", "FX",
             "MOST", "HDS", "N", "TOP", "TREND", "HALT", "ALLQ", "SECF", "WJI"] },
    { label: "Portfolio & Risk",
      cmds: ["EQS", "OMON", "OVME", "CALC", "BROK", "AUM"] },
    { label: "Charting & Technicals",
      cmds: ["G", "HMS", "HP"] },
    { label: "Fundamentals & Filings",
      cmds: ["CF", "IPO", "TRAN"] },
    { label: "Utilities & System",
      cmds: ["HELP", "CHAT", "ACM", "PDF", "AL", "NOTE", "ENT", "CHANGE"] }
  ];

  var selfScript = document.currentScript;
  var ROOT = (selfScript && selfScript.dataset && selfScript.dataset.root)
    ? selfScript.dataset.root : "../..";

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function init() {
    var article = document.querySelector('.doc-wrap');
    if (!article || article.dataset.sidebarInjected === '1') return;
    var all = window.GODEL_COMMANDS || [];
    if (!all.length) return;

    var byCmd = {};
    all.forEach(function (c) { byCmd[c.cmd] = c; });

    /* Current page slug. Works for both .html paths and Cloudflare clean URLs
       (e.g. /docs/commands/qm, with or without a trailing slash). */
    var currentSlug = (location.pathname.replace(/\/+$/, '').split('/').pop() || '').replace(/\.html$/, '');

    /* Prev / next command bar at the very top of the page (tasteful docs nav).
       Order follows the sidebar categories, doc'd commands only, across groups. */
    (function () {
      var order = [];
      CATS.forEach(function (cat) {
        cat.cmds.forEach(function (x) {
          var c = byCmd[x];
          if (c && c.hasDoc) order.push(c);
        });
      });
      var idx = -1;
      for (var i = 0; i < order.length; i++) {
        if (order[i].slug === currentSlug) { idx = i; break; }
      }
      if (idx === -1) return;
      function side(c, dir) {
        if (!c) return '<span class="doc-pn doc-pn-empty" aria-hidden="true"></span>';
        var arrow = '<span class="doc-pn-arrow">' + (dir === 'prev' ? '←' : '→') + '</span>';
        var txt = '<span class="doc-pn-text">' +
                    '<span class="doc-pn-dir">' + (dir === 'prev' ? 'Previous' : 'Next') + '</span>' +
                    '<span class="doc-pn-name"><span class="gt-cmd">' + esc(c.cmd) + '</span>' +
                    '<span class="doc-pn-label">' + esc(c.label) + '</span></span>' +
                  '</span>';
        return '<a class="doc-pn doc-pn-' + dir + '" href="' + esc(c.slug) + '.html">' +
               (dir === 'prev' ? arrow + txt : txt + arrow) + '</a>';
      }
      var bar = document.createElement('nav');
      bar.className = 'doc-prevnext';
      bar.setAttribute('aria-label', 'Previous and next command');
      bar.innerHTML = side(order[idx - 1], 'prev') + side(order[idx + 1], 'next');
      article.insertBefore(bar, article.firstChild);
    })();

    function section(label, openByDefault, bodyHtml) {
      var openCls = openByDefault ? ' is-open' : '';
      var aria = openByDefault ? 'true' : 'false';
      return '<div class="toc-section' + openCls + '">' +
               '<button type="button" class="toc-summary" aria-expanded="' + aria + '">' + esc(label) + '</button>' +
               '<div class="toc-panel"><div class="toc-panel-inner">' + bodyHtml + '</div></div>' +
             '</div>';
    }

    var html = '';

    /* Inline command search — persists at the top of the sidebar on every
       command page so any command is one query away. Wired up after mount. */
    html += '<div class="toc-search-wrap">' +
              '<label class="toc-search">' +
                '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="4.5"/><path d="M11 11l3.4 3.4"/></svg>' +
                '<input class="toc-search-input" type="search" placeholder="Search commands…" aria-label="Search commands" autocomplete="off">' +
              '</label>' +
              '<div class="toc-search-results" role="listbox" hidden></div>' +
            '</div>';

    /* Getting Started — open by default. */
    html += section('Getting Started', true,
      '<ul>' +
        '<li><a href="' + ROOT + '/docs.html">Overview</a></li>' +
        '<li><a href="' + ROOT + '/docs.html#commands">Command reference</a></li>' +
        '<li><a href="' + ROOT + '/docs.html#shortcuts">Keyboard shortcuts</a></li>' +
        '<li><a href="' + ROOT + '/pricing/">Pricing</a></li>' +
      '</ul>');

    /* Commands — top-level open by default; sub-category containing the
       active command auto-opens, others stay collapsed. */
    var commandsBody = '';
    CATS.forEach(function (cat) {
      var items = cat.cmds.map(function (x) { return byCmd[x]; }).filter(Boolean);
      if (!items.length) return;
      var hasActive = items.some(function (c) { return c.slug === currentSlug; });
      var openCls = hasActive ? ' is-open' : '';
      var aria = hasActive ? 'true' : 'false';
      var listHtml = '<ul>';
      items.forEach(function (c) {
        var stub = c.hasDoc ? '' : ' is-stub';
        var active = (c.slug === currentSlug) ? ' is-active' : '';
        var href = c.hasDoc ? ' href="' + esc(c.slug) + '.html"' : '';
        listHtml += '<li><a class="toc-cmd' + stub + active + '"' + href + '>' +
                      '<span class="toc-cmd-code">' + esc(c.cmd) + '</span>' +
                      '<span class="toc-cmd-label">' + esc(c.label) + '</span>' +
                    '</a></li>';
      });
      listHtml += '</ul>';
      commandsBody +=
        '<div class="toc-subsection' + openCls + '">' +
          '<button type="button" class="toc-summary" aria-expanded="' + aria + '">' + esc(cat.label) + '</button>' +
          '<div class="toc-panel"><div class="toc-panel-inner">' + listHtml + '</div></div>' +
        '</div>';
    });
    html += section('Commands', true, commandsBody);

    html += section('Troubleshooting', false,
      '<ul>' +
        '<li><a href="' + ROOT + '/docs/troubleshooting.html">Troubleshooting overview</a></li>' +
        '<li><a href="' + ROOT + '/docs/troubleshooting.html#cancelling-subscription">Cancel subscription</a></li>' +
        '<li><a href="' + ROOT + '/docs/troubleshooting.html#error-code-5-aw-snap-">Error Code 5 ("Aw Snap!")</a></li>' +
      '</ul>');

    var shell = document.createElement('div');
    shell.className = 'doc-shell';
    var aside = document.createElement('aside');
    aside.className = 'docs-toc';
    aside.setAttribute('aria-label', 'Documentation');
    aside.innerHTML = html;

    article.parentNode.insertBefore(shell, article);
    shell.appendChild(aside);
    shell.appendChild(article);
    article.dataset.sidebarInjected = '1';

    /* Wire the inline command search. Filters documented commands by code,
       name, or blurb; navigates to the command page on click or Enter. */
    (function () {
      var wrap = aside.querySelector('.toc-search-wrap');
      if (!wrap) return;
      var input = wrap.querySelector('.toc-search-input');
      var results = wrap.querySelector('.toc-search-results');
      var docd = all.filter(function (c) { return c.hasDoc; });
      var rows = [], active = -1;

      function setActive(i) {
        active = i;
        rows.forEach(function (r, n) { r.classList.toggle('is-active', n === active); });
        if (rows[active]) rows[active].scrollIntoView({ block: 'nearest' });
      }
      function render() {
        var q = input.value.trim().toLowerCase();
        active = -1; rows = [];
        if (!q) { results.hidden = true; results.innerHTML = ''; return; }
        var matches = docd.filter(function (c) {
          return c.cmd.toLowerCase().indexOf(q) !== -1 ||
                 (c.label || '').toLowerCase().indexOf(q) !== -1 ||
                 (c.blurb || '').toLowerCase().indexOf(q) !== -1;
        }).slice(0, 8);
        if (!matches.length) {
          results.innerHTML = '<div class="toc-sr-empty">No commands match &ldquo;' + esc(q) + '&rdquo;</div>';
          results.hidden = false; return;
        }
        results.innerHTML = matches.map(function (c) {
          return '<a class="toc-sr" href="' + esc(c.slug) + '.html" role="option">' +
                   '<span class="gt-cmd">' + esc(c.cmd) + '</span>' +
                   '<span class="sr-label">' + esc(c.label) + '</span>' +
                 '</a>';
        }).join('');
        results.hidden = false;
        rows = [].slice.call(results.querySelectorAll('.toc-sr'));
      }
      input.addEventListener('input', render);
      input.addEventListener('keydown', function (e) {
        if (results.hidden || !rows.length) {
          if (e.key === 'Escape') { input.value = ''; render(); }
          return;
        }
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(active + 1, rows.length - 1)); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(active - 1, 0)); }
        else if (e.key === 'Enter') { var a = rows[active] || rows[0]; if (a) { e.preventDefault(); location.href = a.getAttribute('href'); } }
        else if (e.key === 'Escape') { input.value = ''; render(); }
      });
      document.addEventListener('click', function (e) {
        if (!wrap.contains(e.target)) results.hidden = true;
      });
      input.addEventListener('focus', function () { if (input.value.trim()) render(); });
    })();

    /* Single delegated click handler for collapsibles. */
    if (!window.__GT_TOC_TOGGLE) {
      window.__GT_TOC_TOGGLE = true;
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.docs-toc .toc-summary');
        if (!btn) return;
        var group = btn.parentElement;
        if (!group) return;
        var open = group.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
