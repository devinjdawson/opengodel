/* Shared site footer: black bar + green CTA + legal links + disclaimer.
   Include near the bottom of <body>:
     <script src="site-footer.js"></script>
   It appends the footer markup and its scoped CSS once. */
(function () {
  var selfScript = document.currentScript;
  /* data-root="." on root-level pages, data-root=".." on nested pages
     (e.g. careers/*.html, news/*.html). */
  var ROOT = selfScript && selfScript.dataset && selfScript.dataset.root
    ? selfScript.dataset.root
    : ".";
  function r(path) { return ROOT + "/" + path; }

  /* The home/lander page omits the Newsletter link; every other page shows it. */
  var pathname = (window.location && window.location.pathname) || "/";
  var isLander = pathname === "/" || pathname === "/index.html";

  function init() {
    if (document.getElementById("gt-footer")) return;

    var style = document.createElement("style");
    style.textContent = [
      /* Kill the legacy Squarespace #footer-sections block if it's still
         in the DOM on any migrated page. Safe to always include. */
      "#footer-sections{display:none!important}",
      "#gt-footer{background:#0a0a0a;color:#cfcfcf;border-top:1px solid rgba(255,255,255,0.08);font-family:'Inter','Sofia Sans',sans-serif}",
      "#gt-footer .gt-footer-bottom{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:10px 48px 32px}",
      /* pill lives in the left nav links, away from the HubSpot chat launcher pinned bottom-right
         (the launcher iframe's hit box is larger than the visible bubble) */
      "#gt-footer .gt-footer-try{display:inline-block;box-sizing:border-box;background:#33E29A;color:#06160f;font-family:'Inter',system-ui,sans-serif;font-weight:600;font-size:14px;letter-spacing:0.01em;padding:9px 22px;border-radius:999px;text-decoration:none;transition:background .15s ease}",
      "#gt-footer .gt-footer-try:hover{background:#48efad;text-decoration:none}",
      /* pill is last in the DOM so it stacks below the legal links on mobile;
         on wider screens flex order pulls it back next to the nav links, legal pushed right */
      "@media(min-width:641px){#gt-footer .gt-footer-nav .gt-footer-try{order:2;margin-left:16px}#gt-footer .gt-footer-nav .gt-footer-legal{order:3;margin-left:auto}}",
      "#gt-footer .gt-footer-nav{display:flex;justify-content:space-between;align-items:center;padding:18px 48px;flex-wrap:wrap;gap:12px;border-top:1px solid rgba(255,255,255,0.06)}",
      /* flex + nowrap so each link (and the Try It Now pill) wraps as a whole unit on narrow screens */
      "#gt-footer .gt-footer-links{display:flex;flex-wrap:wrap;align-items:center;gap:14px 36px}",
      "#gt-footer .gt-footer-links a{color:#cfcfcf;text-decoration:none;font-size:15px;white-space:nowrap;transition:color .15s ease}",
      "#gt-footer .gt-footer-links a:hover,#gt-footer .gt-footer-legal a:hover{color:#fff;text-decoration:none}",
      "#gt-footer .gt-footer-legal a{color:#cfcfcf;text-decoration:none;font-size:15px;transition:color .15s ease}",
      "#gt-footer .gt-footer-sep{border:none;border-top:1px solid rgba(255,255,255,0.10);margin:0}",
      "#gt-footer .gt-footer-disclaimer{padding:28px 48px 44px;font-size:14px;line-height:1.65;color:#7e7e7e;max-width:820px}",
      "#gt-footer .gt-footer-copy{font-size:13px;color:#6a6a6a}",
      "@media(max-width:640px){#gt-footer .gt-footer-bottom{padding:10px 20px 28px;flex-direction:column;align-items:flex-start;gap:14px}#gt-footer .gt-footer-nav{padding:16px 20px;flex-direction:column;align-items:flex-start}#gt-footer .gt-footer-disclaimer{padding:20px 20px 32px}}"
    ].join("");
    document.head.appendChild(style);

    var footer = document.createElement("footer");
    footer.id = "gt-footer";
    footer.innerHTML = ''
      + '<div class="gt-footer-nav">'
      +   '<div class="gt-footer-links">'
      +     '<a href="' + r("referral.html") + '">Referral Program</a>'
      +     '<a href="' + r("careers.html") + '">Careers</a>'
      +     '<a href="https://docs.godelterminal.com/" target="_blank" rel="noopener">Documentation</a>'
      +     '<a href="' + r("contact.html") + '">Contact</a>'
      +     (isLander ? '' : '<a href="' + r("newsletter/") + '">Newsletter</a>')
      +   '</div>'
      +   '<div class="gt-footer-legal">'
      +     '<a href="' + r("terms.html") + '">Terms of Service</a>'
      +     '<span style="margin:0 10px;opacity:0.4;">|</span>'
      +     '<a href="' + r("privacypolicy.html") + '">Privacy Policy</a>'
      +     '<span style="margin:0 10px;opacity:0.4;">|</span>'
      +     '<a href="' + r("cookies.html") + '">Cookies</a>'
      +   '</div>'
      +   '<a class="gt-footer-try" href="https://app.godelterminal.com/?page=register" target="_blank" rel="noopener">Try It Now</a>'
      + '</div>'
      + '<hr class="gt-footer-sep">'
      + '<div class="gt-footer-disclaimer">'
      +   'Disclaimer: The information provided on this website by DL Software dba Godel Terminal is strictly for informational purposes only and should not be construed as an offer to sell, a solicitation to buy, or a recommendation for any security or strategy. DL Software dba Godel Terminal is not a broker or registered investment advisor, and we are not registered with any financial or securities regulatory authority to give financial and investment advice. While we make every effort to maintain the accuracy and timeliness of information, we cannot guarantee its absolute accuracy. We strongly recommend conducting personal research or consulting a qualified financial advisor before making any investment decisions. Trading in financial markets involves significant risk, and past performance does not guarantee future results. DL Software dba Godel Terminal, its employees, or its affiliates will not be held liable for any losses or damages arising from the use of any information on this website. Use of this website signifies your agreement to this disclaimer.'
      + '</div>'
      + '<div class="gt-footer-bottom">'
      +   '<div class="gt-footer-copy">DL Software &copy; 2026. All rights reserved.</div>'
      + '</div>';
    document.body.appendChild(footer);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
