# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/openbb
# For Docker Compose (service name 'db'):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/openbb
# For remote PostgreSQL with IP:
# DATABASE_URL=postgresql+asyncpg://user:pass@192.168.1.100:5432/openbb

# =============================================================================
# Redis (for fastapi-cache2, rate limiting, sessions)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
# For Docker Compose (service name 'redis'):
# REDIS_URL=redis://redis:6379/0
# For remote Redis with IP:
# REDIS_URL=redis://192.168.1.100:6379/0

# =============================================================================
# OpenBB Platform
# =============================================================================
OPENBB_API_KEY=your_openbb_api_key_here
OPENBB_PAT=your_openbb_pat_here

# =============================================================================
# Inference (LLM) - Used for chat, reasoning, tool calling
# =============================================================================
# Provider: openai, anthropic, azure, ollama, openrouter, deepseek, groq, together, fireworks, etc.
INFERENCE_PROVIDER=openai
INFERENCE_MODEL=gpt-4o-mini
INFERENCE_API_KEY=your_inference_api_key_here
# Custom base URL (optional):
# - Azure: https://<resource>.openai.azure.com/openai/deployments/<deployment>
# - Ollama: http://localhost:11434/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Local proxy: http://localhost:4000/v1
INFERENCE_BASE_URL=
INFERENCE_TEMPERATURE=0.7
INFERENCE_MAX_TOKENS=4096

# =============================================================================
# Embeddings - Used for vector search, RAG, semantic similarity
# =============================================================================
# Provider: openai, sentence-transformers, azure, ollama, cohere, voyage, jina, mixedbread, etc.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Separate API key for embeddings (optional, falls back to INFERENCE_API_KEY or OPENAI_API_KEY)
EMBEDDING_API_KEY=
# Custom base URL (optional):
# - Azure: https://<resource>.openai.azure.com/openai/deployments/<deployment>
# - Ollama: http://localhost:11434/v1
# - Local proxy: http://localhost:4000/v1
EMBEDDING_BASE_URL=

# =============================================================================
# OpenAI (Legacy/Compat - used as fallback for inference/embedding if not set above)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# App
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# OpenBB MCP Server (for AI agents to access financial data)
# =============================================================================
OPENBB_MCP_URL=http://127.0.0.1:6901/mcp

# =============================================================================
# OpenBB Platform API Server
# =============================================================================
OPENBB_API_URL=http://127.0.0.1:6900

# =============================================================================
# Frontend (Next.js)
# =============================================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# For Docker Compose (service name 'api'):
# NEXT_PUBLIC_API_URL=http://api:8000

# =============================================================================
# External API Keys
# =============================================================================
FRED_API_KEY=your_fred_api_key_here
BENZINGA_API_KEY=your_benzinga_api_key_here