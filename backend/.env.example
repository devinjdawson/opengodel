# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/openbb
# For local development with Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/openbb

# Redis (for fastapi-cache2)
REDIS_URL=redis://localhost:6379/0

# OpenBB
OPENBB_API_KEY=your_openbb_api_key_here
OPENBB_PAT=your_openbb_pat_here

# OpenAI (for embeddings) - optional, can use sentence-transformers locally
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# App
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000